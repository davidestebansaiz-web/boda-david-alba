{
  "name": "wedding-api",
  "version": "1.0.0",
  "description": "Contract-first Fastify API for invitations and RSVPs",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && tsx prisma/backfill-invitation-qr.ts",
    "db:deploy": "prisma migrate deploy && tsx prisma/backfill-invitation-qr.ts",
    "db:backfill:qr": "tsx prisma/backfill-invitation-qr.ts",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "smoke": "tsx scripts/smoke.ts"
  },
  "keywords": [
    "fastify",
    "openapi",
    "prisma",
    "hexagonal"
  ],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.6.1",
    "qrcode": "^1.5.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
